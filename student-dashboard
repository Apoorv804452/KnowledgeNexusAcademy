                routine = routines[String(classVal)] || routines['9'];
                return Promise.resolve();
            }

            // --- RENDER FUNCTIONS ---
            function renderAll() {
                renderNotices();
                renderRoutine();
                renderSubjects();
                renderChapters();
                renderHomework();
                renderTests();
                renderNotes();
                renderAttendance();
                renderFees();
                renderProfile();
                updateStats();
                updateBadges();
                document.getElementById('dashDate').textContent = new Date().toLocaleDateString('en-US', { weekday: 'short',
                    month: 'short', day: 'numeric', year: 'numeric' });
            }

            function renderNotices() {
                const container = document.getElementById('noticeContainer');
                if (!container) return;
                if (noticeList.length === 0) {
                    container.innerHTML = '<div class="empty-state"><i class="fas fa-bullhorn"></i> No notices available.</div>';
                    return;
                }
                let html = '';
                noticeList.forEach(n => {
                    const date = n.createdAt ? new Date(n.createdAt.seconds * 1000).toLocaleDateString() : 'N/A';
                    html += `
                            <div class="notice-item">
                                <div class="notice-title">${n.title}</div>
                                <div class="notice-text">${n.message}</div>
                                <div class="notice-meta">
                                    <span><i class="far fa-calendar-alt"></i> ${date}</span>
                                    <span><i class="fas fa-tag"></i> ${n.targetType === 'all' ? 'All Students' : n.targetType === 'class' ? 'Class ' + n.targetId : 'Personal'}</span>
                                </div>
                            </div>
                        `;
                });
                container.innerHTML = html;
            }

            function renderRoutine() {
                const container = document.getElementById('routineContainer');
                if (!container) return;
                const today = new Date();
                const dayName = getDayName(today);
                document.getElementById('routineDay').textContent = dayName;
                const classes = routine[dayName] || [];
                if (classes.length === 0 || (classes.length === 1 && classes[0].subject === 'Holiday')) {
                    container.innerHTML =
                        `<div class="empty-state" style="padding:1rem;"><i class="fas fa-umbrella-beach"></i> No classes today! Enjoy your holiday.</div>`;
                    return;
                }
                let html = '';
                classes.forEach(cls => {
                    const isBreak = cls.subject === 'Break';
                    html += `
                            <div class="routine-item" style="${isBreak ? 'opacity:0.6; border-left-color: #94a3b8;' : ''}">
                                <span class="time">${cls.time}</span>
                                <span class="subject-name">${cls.subject}</span>
                            </div>
                        `;
                });
                container.innerHTML = html;
            }

            function renderSubjects() {
                const container = document.getElementById('subjectsContainer');
                if (!container) return;
                if (subjectList.length === 0) {
                    container.innerHTML = '<div class="empty-state"><i class="fas fa-th-list"></i> No subjects added yet.</div>';
                    return;
                }
                let html = '<div class="subject-grid">';
                subjectList.forEach(s => {
                    const color = getSubjectColor(s.name);
                    html += `
                            <div class="subject-card-mini">
                                <span class="sub-icon" style="color:${color}"><i class="fas ${getSubjectIcon(s.name)}"></i></span>
                                <div class="sub-name">${s.name}</div>
                                ${s.teacher ? `<div class="sub-teacher">👨‍🏫 ${s.teacher}</div>` : ''}
                                ${s.code ? `<div class="sub-teacher">📚 ${s.code}</div>` : ''}
                            </div>
                        `;
                });
                html += '</div>';
                container.innerHTML = html;
            }

            function renderChapters() {
                const container = document.getElementById('chaptersContainer');
                if (!container) return;
                if (chapterList.length === 0) {
                    container.innerHTML = '<div class="empty-state"><i class="fas fa-layer-group"></i> No chapters added yet.</div>';
                    return;
                }
                let html = '<table class="data-table"><thead><tr><th>Subject</th><th>Chapter</th><th>Description</th></tr></thead><tbody>';
                chapterList.forEach(c => {
                    html += `
                            <tr>
                                <td>${c.subject}</td>
                                <td>${c.number ? 'Ch.' + c.number + ' ' : ''}${c.name}</td>
                                <td>${c.description || '-'}</td>
                            </tr>
                        `;
                });
                html += '</tbody></table>';
                container.innerHTML = html;
            }

            function renderHomework() {
                const container = document.getElementById('homeworkContainer');
                if (!container) return;
                if (homeworkList.length === 0) {
                    container.innerHTML = '<div class="empty-state"><i class="fas fa-book"></i> No homework assigned yet.</div>';
                    return;
                }
                let html = '<table class="data-table"><thead><tr><th>Title</th><th>Subject</th><th>Due Date</th><th>Status</th></tr></thead><tbody>';
                homeworkList.forEach(h => {
                    const status = h.done ? '✅ Done' : '⏳ Pending';
                    html += `
                            <tr>
                                <td>${h.title}</td>
                                <td>${h.subject}</td>
                                <td>${h.dueDate || 'N/A'}</td>
                                <td>${status}</td>
                            </tr>
                        `;
                });
                html += '</tbody></table>';
                container.innerHTML = html;
            }

            function renderTests() {
                const container = document.getElementById('testsContainer');
                if (!container) return;
                if (testList.length === 0) {
                    container.innerHTML = '<div class="empty-state"><i class="fas fa-pencil-alt"></i> No tests recorded yet.</div>';
                    return;
                }
                let html = '<table class="data-table"><thead><tr><th>Test</th><th>Subject</th><th>Marks</th><th>Date</th></tr></thead><tbody>';
                testList.forEach(t => {
                    const marksDisplay = t.marks !== null && t.marks !== undefined ? t.marks + '/' + t.maxMarks :
                        'Pending';
                    html += `
                            <tr>
                                <td>${t.name}</td>
                                <td>${t.subject}</td>
                                <td>${marksDisplay}</td>
                                <td>${t.date || 'N/A'}</td>
                            </tr>
                        `;
                });
                html += '</tbody></table>';
                container.innerHTML = html;
            }

            function renderNotes() {
                const container = document.getElementById('notesContainer');
                if (!container) return;
                if (notesList.length === 0) {
                    container.innerHTML = '<div class="empty-state"><i class="fas fa-sticky-note"></i> No notes available yet.</div>';
                    return;
                }
                let html = '<table class="data-table"><thead><tr><th>Title</th><th>Subject</th><th>Content</th></tr></thead><tbody>';
                notesList.forEach(n => {
                    html += `
                            <tr>
                                <td>${n.title}</td>
                                <td>${n.subject}</td>
                                <td>${n.content ? n.content.substring(0, 80) + (n.content.length > 80 ? '...' : '') : '-'}</td>
                            </tr>
                        `;
                });
                html += '</tbody></table>';
                container.innerHTML = html;
            }

            function renderAttendance() {
                const container = document.getElementById('attendanceContainer');
                if (!container) return;
                const records = Object.entries(attendanceRecords).map(([key, status]) => {
                    const dateStr = key.split('_')[0];
                    return { date: dateStr, status };
                });
                if (records.length === 0) {
                    container.innerHTML =
                        '<div class="empty-state"><i class="fas fa-clipboard-check"></i> No attendance records yet.</div>';
                    return;
                }
                records.sort((a, b) => b.date.localeCompare(a.date));
                const recent = records.slice(0, 30);
                let html = `
                        <div style="margin-bottom:0.8rem; display:flex; gap:1rem; flex-wrap:wrap;">
                            <span style="font-size:0.8rem; color:#64748b;">Total: <strong>${records.length}</strong></span>
                            <span style="font-size:0.8rem; color:#64748b;">Present: <strong style="color:#22c55e;">${records.filter(r => r.status === 'present').length}</strong></span>
                            <span style="font-size:0.8rem; color:#64748b;">Absent: <strong style="color:#ef4444;">${records.filter(r => r.status === 'absent').length}</strong></span>
                            <span style="font-size:0.8rem; color:#64748b;">Partial: <strong style="color:#f59e0b;">${records.filter(r => r.status === 'partial').length}</strong></span>
                        </div>
                        <div class="attendance-grid">
                    `;
                recent.forEach(r => {
                    const date = new Date(r.date + 'T00:00:00');
                    const dayNum = date.getDate();
                    const month = date.toLocaleString('default', { month: 'short' });
                    const statusClass = r.status === 'present' ? 'present' : r.status === 'absent' ? 'absent' :
                        'partial';
                    const statusLabel = r.status === 'present' ? '✅' : r.status === 'absent' ? '❌' : '⏳';
                    html += `
                            <div class="att-day ${statusClass}">
                                <span class="day-num">${dayNum}</span>
                                <span style="font-size:0.6rem;">${month}</span>
                                <span style="display:block; font-size:0.7rem;">${statusLabel}</span>
                            </div>
                        `;
                });
                html += '</div>';
                container.innerHTML = html;
            }

            function renderFees() {
                const container = document.getElementById('feeContainer');
                if (!container) return;
                if (feeRecords.length === 0) {
                    container.innerHTML = '<div class="empty-state"><i class="fas fa-rupee-sign"></i> No fee records found.</div>';
                    return;
                }
                let html = '<table class="data-table"><thead><tr><th>Month</th><th>Amount</th><th>Status</th></tr></thead><tbody>';
                feeRecords.forEach(f => {
                    const statusColor = f.status === 'Paid' ? '#22c55e' : f.status === 'Partial' ? '#f59e0b' :
                        '#ef4444';
                    html += `
                            <tr>
                                <td>${f.month}</td>
                                <td>₹${f.amount}</td>
                                <td style="font-weight:600; color:${statusColor};">${f.status}</td>
                            </tr>
                        `;
                });
                html += '</tbody></table>';
                container.innerHTML = html;
            }

            function renderProfile() {
                const container = document.getElementById('profileContainer');
                if (!container || !studentData) return;
                container.innerHTML = `
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; max-width:600px;">
                            <div style="padding:0.8rem; background:#f8fafc; border-radius:12px;">
                                <div style="font-size:0.7rem; color:#94a3b8;">Full Name</div>
                                <div style="font-weight:600; color:#0b1e3a;">${studentData.name || 'N/A'}</div>
                            </div>
                            <div style="padding:0.8rem; background:#f8fafc; border-radius:12px;">
                                <div style="font-size:0.7rem; color:#94a3b8;">Email</div>
                                <div style="font-weight:600; color:#0b1e3a;">${studentData.email || 'N/A'}</div>
                            </div>
                            <div style="padding:0.8rem; background:#f8fafc; border-radius:12px;">
                                <div style="font-size:0.7rem; color:#94a3b8;">Class</div>
                                <div style="font-weight:600; color:#0b1e3a;">${getClassDisplay(studentData.class)}</div>
                            </div>
                            <div style="padding:0.8rem; background:#f8fafc; border-radius:12px;">
                                <div style="font-size:0.7rem; color:#94a3b8;">Parent Contact</div>
                                <div style="font-weight:600; color:#0b1e3a;">${studentData.parentContact || 'N/A'}</div>
                            </div>
                            <div style="padding:0.8rem; background:#f8fafc; border-radius:12px; grid-column:1/-1;">
                                <div style="font-size:0.7rem; color:#94a3b8;">Address</div>
                                <div style="font-weight:600; color:#0b1e3a;">${studentData.address || 'N/A'}</div>
                            </div>
                        </div>
                    `;
            }

            // --- UPDATE STATS ---
            function updateStats() {
                const present = Object.values(attendanceRecords).filter(s => s === 'present').length;
                const absent = Object.values(attendanceRecords).filter(s => s === 'absent').length;
                const partial = Object.values(attendanceRecords).filter(s => s === 'partial').length;

                document.getElementById('statPresent').textContent = present;
                document.getElementById('statAbsent').textContent = absent;
                document.getElementById('statPartial').textContent = partial;
                document.getElementById('statHomework').textContent = homeworkList.length;
                document.getElementById('statTests').textContent = testList.length;
                document.getElementById('statNotes').textContent = notesList.length;

                document.getElementById('dashPresent').textContent = present;
                document.getElementById('dashAbsent').textContent = absent;
                document.getElementById('dashPartial').textContent = partial;
                document.getElementById('dashTests').textContent = testList.length;
                document.getElementById('dashHomework').textContent = homeworkList.length;
            }

            function updateBadges() {
                document.getElementById('noticeBadge').textContent = noticeList.length;
                document.getElementById('hwBadge').textContent = homeworkList.length;
                document.getElementById('testBadge').textContent = testList.length;
                document.getElementById('notesBadge').textContent = notesList.length;
            }

            // --- ESCAPE TOAST ---
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    const toast = document.getElementById('toast');
                    toast.classList.remove('show');
                    clearTimeout(toastTimeout);
                }
            });

            console.log('📚 Knowledge Nexus — Student Dashboard');
            console.log('📌 Class-aware: Shows content based on student\'s class');

        })();
    </script>

</body>
</html>
