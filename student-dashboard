<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Dashboard | Knowledge Nexus</title>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js">
    </script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js">
    </script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js">
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        /* ---------- Same styles as the student dashboard from previous response ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #f0f4ff;
            color: #1e293b;
            min-height: 100vh;
        }
        .floating-bubble {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            animation: floatBubble linear infinite;
            will-change: transform, opacity;
            user-select: none;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 0 40px rgba(99, 102, 241, 0.06);
            opacity: 0.5;
        }
        @keyframes floatBubble {
            0% {
                transform: translateY(100vh) translateX(0px) scale(0.6);
                opacity: 0;
            }
            15% {
                opacity: 0.5;
            }
            85% {
                opacity: 0.5;
            }
            100% {
                transform: translateY(-10vh) translateX(40px) scale(1.2);
                opacity: 0;
            }
        }
        .site-wrapper {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.5rem;
        }
        .top-nav {
            background: rgba(255, 255, 255, 0.80);
            backdrop-filter: blur(14px);
            border-radius: 2rem;
            padding: 0.7rem 1.8rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.6);
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 0.8rem;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
        }
        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(145deg, #1e3a8a, #2563eb);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.2rem;
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.20);
        }
        .brand h1 {
            font-size: 1.2rem;
            font-weight: 800;
            color: #0b1e3a;
        }
        .brand h1 span {
            color: #2563eb;
        }
        .brand .tagline-small {
            font-size: 0.7rem;
            font-weight: 500;
            color: #94a3b8;
            margin-left: 0.2rem;
        }
        .user-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .user-section .greeting {
            font-size: 0.85rem;
            font-weight: 600;
            color: #1e293b;
        }
        .user-section .greeting span {
            color: #2563eb;
        }
        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
            text-transform: uppercase;
            flex-shrink: 0;
        }
        .btn-logout {
            background: transparent;
            border: 1.5px solid #e2e8f0;
            color: #64748b;
            padding: 0.4rem 1.2rem;
            border-radius: 60px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .btn-logout:hover {
            background: #fef2f2;
            border-color: #ef4444;
            color: #b91c1c;
        }
        .hero-banner {
            background: linear-gradient(135deg, #1e3a8a, #2563eb);
            border-radius: 2rem;
            padding: 1.6rem 2.5rem;
            color: #fff;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 16px 48px rgba(37, 99, 235, 0.20);
        }
        .hero-banner::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            pointer-events: none;
        }
        .hero-banner h2 {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-bottom: 0.2rem;
        }
        .hero-banner h2 i {
            color: #fcd34d;
            margin-right: 0.4rem;
        }
        .hero-banner p {
            font-size: 0.95rem;
            opacity: 0.85;
            max-width: 600px;
        }
        .hero-banner .class-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(4px);
            padding: 0.2rem 1.2rem;
            border-radius: 60px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            margin-top: 0.4rem;
            border: 1px solid rgba(255, 255, 255, 0.10);
        }
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            border-radius: 1.2rem;
            padding: 1rem;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
            transition: transform 0.15s ease;
        }
        .stat-card:hover {
            transform: translateY(-3px);
        }
        .stat-card .stat-number {
            font-size: 1.8rem;
            font-weight: 800;
            color: #0b1e3a;
            line-height: 1.2;
        }
        .stat-card .stat-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .stat-card .stat-icon {
            font-size: 1.2rem;
            margin-bottom: 0.1rem;
            display: block;
        }
        .stat-card .stat-icon.green {
            color: #22c55e;
        }
        .stat-card .stat-icon.red {
            color: #ef4444;
        }
        .stat-card .stat-icon.yellow {
            color: #f59e0b;
        }
        .stat-card .stat-icon.blue {
            color: #3b82f6;
        }
        .stat-card .stat-icon.purple {
            color: #8b5cf6;
        }
        .stat-card .stat-icon.orange {
            color: #f97316;
        }
        .dashboard-layout {
            display: flex;
            gap: 1.8rem;
            align-items: flex-start;
        }
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            border-radius: 1.8rem;
            padding: 1.2rem 0.8rem;
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
            position: sticky;
            top: 1.5rem;
            max-height: calc(100vh - 3rem);
            overflow-y: auto;
        }
        .sidebar::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        .sidebar .sidebar-title {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94a3b8;
            padding: 0.5rem 1rem 0.8rem;
        }
        .sidebar .nav-item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.7rem 1rem;
            border-radius: 1rem;
            cursor: pointer;
            transition: all 0.2s ease;
            color: #64748b;
            font-weight: 500;
            font-size: 0.85rem;
            border: none;
            background: transparent;
            width: 100%;
            font-family: 'Inter', sans-serif;
        }
        .sidebar .nav-item:hover {
            background: #eef2ff;
            color: #1e293b;
        }
        .sidebar .nav-item.active {
            background: #dbeafe;
            color: #1e3a8a;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(37, 99, 235, 0.06);
        }
        .sidebar .nav-item i {
            width: 20px;
            text-align: center;
            font-size: 1rem;
        }
        .sidebar .nav-item .badge {
            margin-left: auto;
            background: #e2e8f0;
            padding: 0.05rem 0.5rem;
            border-radius: 60px;
            font-size: 0.6rem;
            font-weight: 700;
            color: #64748b;
        }
        .sidebar .nav-item.active .badge {
            background: #2563eb;
            color: #fff;
        }
        .content-area {
            flex: 1;
            min-width: 0;
        }
        .section-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            border-radius: 1.8rem;
            padding: 1.8rem 2rem;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.6);
            margin-bottom: 1.8rem;
            display: none;
        }
        .section-card.active {
            display: block;
            animation: fadeSlide 0.3s ease;
        }
        @keyframes fadeSlide {
            0% {
                opacity: 0;
                transform: translateY(10px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .section-card .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.2rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .section-card .section-header h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #0b1e3a;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .section-card .section-header h3 i {
            color: #2563eb;
        }
        .section-card .section-header .sub-text {
            font-size: 0.8rem;
            color: #94a3b8;
            font-weight: 500;
        }
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        .data-table th {
            text-align: left;
            padding: 0.6rem 0.8rem;
            background: #f1f5f9;
            font-weight: 600;
            color: #475569;
            border-bottom: 2px solid #e2e8f0;
        }
        .data-table td {
            padding: 0.6rem 0.8rem;
            border-bottom: 1px solid #eef2f6;
        }
        .data-table tr:hover td {
            background: #f8fafc;
        }
        .empty-state {
            text-align: center;
            color: #94a3b8;
            padding: 2rem 0;
        }
        .empty-state i {
            font-size: 2.5rem;
            color: #cbd5e1;
            display: block;
            margin-bottom: 0.5rem;
        }
        .notice-item {
            padding: 0.8rem 1rem;
            background: #f8fafc;
            border-radius: 12px;
            border-left: 4px solid #2563eb;
            margin-bottom: 0.6rem;
        }
        .notice-item .notice-title {
            font-weight: 600;
            color: #0b1e3a;
        }
        .notice-item .notice-text {
            font-size: 0.9rem;
            color: #475569;
            margin-top: 0.1rem;
        }
        .notice-item .notice-meta {
            font-size: 0.65rem;
            color: #94a3b8;
            margin-top: 0.2rem;
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
        }
        .subject-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 1rem;
            margin-top: 0.5rem;
        }
        .subject-card-mini {
            background: #f8fafc;
            border-radius: 1rem;
            padding: 1rem;
            text-align: center;
            border: 1px solid #eef2f6;
            transition: all 0.2s ease;
        }
        .subject-card-mini:hover {
            border-color: #2563eb;
            transform: translateY(-2px);
        }
        .subject-card-mini .sub-icon {
            font-size: 1.5rem;
            display: block;
            margin-bottom: 0.3rem;
        }
        .subject-card-mini .sub-name {
            font-weight: 600;
            font-size: 0.85rem;
            color: #0b1e3a;
        }
        .subject-card-mini .sub-teacher {
            font-size: 0.7rem;
            color: #94a3b8;
        }
        .routine-item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.5rem 0.8rem;
            background: #f8fafc;
            border-radius: 10px;
            border-left: 4px solid #2563eb;
            margin-bottom: 0.4rem;
            font-size: 0.85rem;
        }
        .routine-item .time {
            font-size: 0.7rem;
            font-weight: 600;
            color: #94a3b8;
            min-width: 70px;
        }
        .routine-item .subject-name {
            flex: 1;
            font-weight: 500;
        }
        .attendance-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
            gap: 0.3rem;
            margin-top: 0.5rem;
        }
        .attendance-grid .att-day {
            text-align: center;
            padding: 0.3rem;
            border-radius: 6px;
            font-size: 0.7rem;
            font-weight: 600;
            background: #f1f5f9;
            color: #94a3b8;
        }
        .attendance-grid .att-day.present {
            background: #f0fdf4;
            color: #166534;
        }
        .attendance-grid .att-day.absent {
            background: #fef2f2;
            color: #b91c1c;
        }
        .attendance-grid .att-day.partial {
            background: #fffbeb;
            color: #92400e;
        }
        .attendance-grid .att-day .day-num {
            display: block;
            font-size: 0.8rem;
        }
        .toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: #1e293b;
            color: #fff;
            padding: 0.8rem 1.5rem;
            border-radius: 60px;
            font-size: 0.85rem;
            font-weight: 500;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
            z-index: 999;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            transform: translateY(120px);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            max-width: 90%;
        }
        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }
        .toast i {
            font-size: 1.1rem;
        }
        .toast.success i {
            color: #4ade80;
        }
        .toast.error i {
            color: #f87171;
        }
        .toast.info i {
            color: #60a5fa;
        }
        @media (max-width: 1024px) {
            .dashboard-layout {
                flex-direction: column;
            }
            .sidebar {
                width: 100%;
                position: static;
                max-height: none;
                display: flex;
                flex-wrap: wrap;
                gap: 0.3rem;
                padding: 0.8rem;
                border-radius: 1.4rem;
            }
            .sidebar .sidebar-title {
                display: none;
            }
            .sidebar .nav-item {
                padding: 0.5rem 0.8rem;
                font-size: 0.8rem;
                width: auto;
                border-radius: 60px;
            }
            .sidebar .nav-item .badge {
                display: none;
            }
        }
        @media (max-width: 768px) {
            .site-wrapper {
                padding: 1rem;
            }
            .top-nav {
                padding: 0.6rem 1.2rem;
                border-radius: 1.5rem;
                gap: 0.5rem;
            }
            .brand h1 {
                font-size: 1rem;
            }
            .brand .tagline-small {
                display: none;
            }
            .hero-banner {
                padding: 1.2rem 1.2rem;
                border-radius: 1.5rem;
            }
            .hero-banner h2 {
                font-size: 1.2rem;
            }
            .hero-banner p {
                font-size: 0.8rem;
            }
            .stats-row {
                grid-template-columns: repeat(3, 1fr);
                gap: 0.5rem;
            }
            .stat-card {
                padding: 0.6rem 0.3rem;
            }
            .stat-card .stat-number {
                font-size: 1.2rem;
            }
            .section-card {
                padding: 1.2rem 1rem;
                border-radius: 1.4rem;
            }
            .section-card .section-header h3 {
                font-size: 1rem;
            }
            .data-table {
                font-size: 0.75rem;
            }
            .data-table th,
            .data-table td {
                padding: 0.4rem 0.5rem;
            }
            .user-section .greeting {
                font-size: 0.7rem;
            }
            .btn-logout span {
                display: none;
            }
            .btn-logout i {
                font-size: 1rem;
            }
            .btn-logout {
                padding: 0.4rem 0.8rem;
            }
            .subject-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .toast {
                bottom: 1rem;
                right: 1rem;
                left: 1rem;
                border-radius: 1rem;
                justify-content: center;
                font-size: 0.8rem;
                padding: 0.7rem 1.2rem;
            }
            .attendance-grid {
                grid-template-columns: repeat(7, 1fr);
            }
        }
        @media (max-width: 480px) {
            .stats-row {
                grid-template-columns: repeat(2, 1fr);
            }
            .sidebar .nav-item {
                font-size: 0.7rem;
                padding: 0.4rem 0.6rem;
            }
            .subject-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- ===== FLOATING BUBBLES ===== -->
    <div class="floating-bubble" style="width:100px;height:100px;left:5%;background:rgba(99,102,241,0.08);animation-duration:30s;animation-delay:0s;"></div>
    <div class="floating-bubble" style="width:70px;height:70px;left:85%;background:rgba(139,92,246,0.10);animation-duration:35s;animation-delay:1.5s;"></div>
    <div class="floating-bubble" style="width:50px;height:50px;left:50%;background:rgba(13,148,136,0.08);animation-duration:25s;animation-delay:0.8s;"></div>
    <div class="floating-bubble" style="width:120px;height:120px;left:20%;background:rgba(245,158,11,0.06);animation-duration:40s;animation-delay:0.3s;"></div>
    <div class="floating-bubble" style="width:60px;height:60px;left:70%;background:rgba(236,72,153,0.08);animation-duration:28s;animation-delay:2s;"></div>

    <div class="site-wrapper">
        <nav class="top-nav">
            <a href="#" class="brand">
                <div class="brand-icon"><i class="fas fa-graduation-cap"></i></div>
                <div><h1>Knowledge <span>Nexus</span></h1><span class="tagline-small">From Confusion to Clarity</span></div>
            </a>
            <div class="user-section">
                <span class="greeting"><i class="fas fa-hand-wave" style="color:#f59e0b;"></i> <span id="studentName">Student</span></span>
                <div class="avatar" id="studentAvatar">SN</div>
                <button class="btn-logout" id="logoutBtn"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></button>
            </div>
        </nav>

        <div class="hero-banner">
            <h2><i class="fas fa-rocket"></i> Student Dashboard</h2>
            <p id="welcomeMessage">Welcome! Here's your personalized learning dashboard.</p>
            <div class="class-badge" id="classBadge"><i class="fas fa-book-open"></i> Class 9 · CBSE</div>
        </div>

        <div class="stats-row">
            <div class="stat-card"><span class="stat-icon green"><i class="fas fa-check-circle"></i></span><div class="stat-number" id="statPresent">0</div><div class="stat-label">Present</div></div>
            <div class="stat-card"><span class="stat-icon red"><i class="fas fa-times-circle"></i></span><div class="stat-number" id="statAbsent">0</div><div class="stat-label">Absent</div></div>
            <div class="stat-card"><span class="stat-icon yellow"><i class="fas fa-clock"></i></span><div class="stat-number" id="statPartial">0</div><div class="stat-label">Partial</div></div>
            <div class="stat-card"><span class="stat-icon blue"><i class="fas fa-book"></i></span><div class="stat-number" id="statHomework">0</div><div class="stat-label">Homework</div></div>
            <div class="stat-card"><span class="stat-icon purple"><i class="fas fa-pencil-alt"></i></span><div class="stat-number" id="statTests">0</div><div class="stat-label">Tests</div></div>
            <div class="stat-card"><span class="stat-icon orange"><i class="fas fa-sticky-note"></i></span><div class="stat-number" id="statNotes">0</div><div class="stat-label">Notes</div></div>
        </div>

        <div class="dashboard-layout">
            <nav class="sidebar">
                <div class="sidebar-title">MENU</div>
                <button class="nav-item active" data-section="dashboard"><i class="fas fa-th-large"></i> Dashboard</button>
                <button class="nav-item" data-section="notice-board"><i class="fas fa-bullhorn"></i> Notice Board <span class="badge" id="noticeBadge">0</span></button>
                <button class="nav-item" data-section="routine"><i class="fas fa-clock"></i> Routine</button>
