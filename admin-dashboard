<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | Knowledge Nexus</title>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js">
    </script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js">
    </script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js">
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        /* Same base styles as teacher dashboard */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #f0f4ff;
            color: #1e293b;
            min-height: 100vh;
        }
        .site-wrapper {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.5rem;
        }
        .top-nav {
            background: rgba(255, 255, 255, 0.80);
            backdrop-filter: blur(14px);
            border-radius: 2rem;
            padding: 0.7rem 1.8rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border: 1px solid rgba(255, 255, 255, 0.6);
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 0.8rem;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
        }
        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(145deg, #1e3a8a, #2563eb);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.2rem;
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.20);
        }
        .brand h1 {
            font-size: 1.2rem;
            font-weight: 800;
            color: #0b1e3a;
        }
        .brand h1 span {
            color: #2563eb;
        }
        .user-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
            text-transform: uppercase;
        }
        .btn-logout {
            background: transparent;
            border: 1.5px solid #e2e8f0;
            color: #64748b;
            padding: 0.4rem 1.2rem;
            border-radius: 60px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
        }
        .btn-logout:hover {
            background: #fef2f2;
            border-color: #ef4444;
            color: #b91c1c;
        }
        .hero-banner {
            background: linear-gradient(135deg, #1e3a8a, #2563eb);
            border-radius: 2rem;
            padding: 1.6rem 2.5rem;
            color: #fff;
            margin-bottom: 2rem;
        }
        .hero-banner h2 {
            font-size: 1.6rem;
            font-weight: 800;
        }
        .hero-banner h2 i {
            color: #fcd34d;
            margin-right: 0.4rem;
        }
        .hero-banner p {
            font-size: 0.95rem;
            opacity: 0.85;
        }
        .hero-banner .admin-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.15);
            padding: 0.2rem 1.2rem;
            border-radius: 60px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-top: 0.4rem;
            border: 1px solid rgba(255, 255, 255, 0.10);
        }
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            border-radius: 1.2rem;
            padding: 1rem;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .stat-card .stat-number {
            font-size: 1.8rem;
            font-weight: 800;
            color: #0b1e3a;
        }
        .stat-card .stat-label {
            font-size: 0.65rem;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
        }
        .stat-card .stat-icon {
            font-size: 1.2rem;
            display: block;
        }
        .stat-card .stat-icon.blue {
            color: #3b82f6;
        }
        .stat-card .stat-icon.green {
            color: #22c55e;
        }
        .stat-card .stat-icon.purple {
            color: #8b5cf6;
        }
        .stat-card .stat-icon.orange {
            color: #f97316;
        }
        .stat-card .stat-icon.red {
            color: #ef4444;
        }
        .stat-card .stat-icon.yellow {
            color: #f59e0b;
        }

        .dashboard-layout {
            display: flex;
            gap: 1.8rem;
            align-items: flex-start;
        }
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            border-radius: 1.8rem;
            padding: 1.2rem 0.8rem;
            border: 1px solid rgba(255, 255, 255, 0.6);
            position: sticky;
            top: 1.5rem;
            max-height: calc(100vh - 3rem);
            overflow-y: auto;
        }
        .sidebar .sidebar-title {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            color: #94a3b8;
            padding: 0.5rem 1rem 0.8rem;
        }
        .sidebar .nav-item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.7rem 1rem;
            border-radius: 1rem;
            cursor: pointer;
            transition: all 0.2s ease;
            color: #64748b;
            font-weight: 500;
            font-size: 0.85rem;
            border: none;
            background: transparent;
            width: 100%;
            font-family: 'Inter', sans-serif;
        }
        .sidebar .nav-item:hover {
            background: #eef2ff;
            color: #1e293b;
        }
        .sidebar .nav-item.active {
            background: #dbeafe;
            color: #1e3a8a;
            font-weight: 600;
        }
        .sidebar .nav-item i {
            width: 20px;
            text-align: center;
        }
        .sidebar .nav-item .badge {
            margin-left: auto;
            background: #e2e8f0;
            padding: 0.05rem 0.5rem;
            border-radius: 60px;
            font-size: 0.6rem;
            font-weight: 700;
            color: #64748b;
        }
        .sidebar .nav-item.active .badge {
            background: #2563eb;
            color: #fff;
        }
        .content-area {
            flex: 1;
            min-width: 0;
        }
        .section-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
            border-radius: 1.8rem;
            padding: 1.8rem 2rem;
            border: 1px solid rgba(255, 255, 255, 0.6);
            margin-bottom: 1.8rem;
            display: none;
        }
        .section-card.active {
            display: block;
            animation: fadeSlide 0.3s ease;
        }
        @keyframes fadeSlide {
            0% {
                opacity: 0;
                transform: translateY(10px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .section-card .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.2rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .section-card .section-header h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #0b1e3a;
        }
        .section-card .section-header h3 i {
            color: #2563eb;
            margin-right: 0.6rem;
        }
        .section-card .section-header .sub-text {
            font-size: 0.8rem;
            color: #94a3b8;
        }
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        .form-grid .full-width {
            grid-column: 1 / -1;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }
        .form-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #1e293b;
        }
        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 0.6rem 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 0.85rem;
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            outline: none;
            transition: border-color 0.2s;
        }
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: #2563eb;
            background: #fff;
        }
        .form-group textarea {
            resize: vertical;
            min-height: 70px;
        }
        .btn-primary {
            padding: 0.6rem 1.8rem;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            border: none;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            transition: 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(37, 99, 235, 0.25);
        }
        .btn-success {
            background: linear-gradient(135deg, #22c55e, #16a34a);
        }
        .btn-success:hover {
            box-shadow: 0 8px 24px rgba(34, 197, 94, 0.25);
        }
        .btn-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }
        .btn-danger:hover {
            box-shadow: 0 8px 24px rgba(239, 68, 68, 0.25);
        }
        .btn-orange {
            background: linear-gradient(135deg, #f97316, #ea580c);
        }
        .btn-orange:hover {
            box-shadow: 0 8px 24px rgba(249, 115, 22, 0.25);
        }
        .btn-purple {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }
        .btn-purple:hover {
            box-shadow: 0 8px 24px rgba(139, 92, 246, 0.25);
        }
        .btn-sm {
            padding: 0.3rem 1rem;
            font-size: 0.75rem;
        }
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        .data-table th {
            text-align: left;
            padding: 0.6rem 0.8rem;
            background: #f1f5f9;
            font-weight: 600;
            color: #475569;
            border-bottom: 2px solid #e2e8f0;
        }
        .data-table td {
            padding: 0.6rem 0.8rem;
            border-bottom: 1px solid #eef2f6;
        }
        .data-table tr:hover td {
            background: #f8fafc;
        }
        .data-table .actions button {
            background: none;
            border: none;
            cursor: pointer;
            color: #94a3b8;
            padding: 0.2rem 0.4rem;
            border-radius: 4px;
        }
        .data-table .actions button:hover {
            background: #eef2ff;
            color: #2563eb;
        }
        .data-table .actions button.danger:hover {
            background: #fef2f2;
            color: #ef4444;
        }
        .empty-state {
            text-align: center;
            color: #94a3b8;
            padding: 2rem 0;
        }
        .empty-state i {
            font-size: 2.5rem;
            color: #cbd5e1;
            display: block;
            margin-bottom: 0.5rem;
        }
        .local-notice {
            background: #fef3c7;
            border: 1px solid #fcd34d;
            border-radius: 1rem;
            padding: 1rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }
        .local-notice i {
            color: #d97706;
            font-size: 1.2rem;
        }
        .local-notice p {
            color: #92400e;
            font-size: 0.9rem;
        }
        .toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: #1e293b;
            color: #fff;
            padding: 0.8rem 1.5rem;
            border-radius: 60px;
            font-size: 0.85rem;
            font-weight: 500;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
            z-index: 999;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            transform: translateY(120px);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            max-width: 90%;
        }
        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }
        .toast i {
            font-size: 1.1rem;
        }
        .toast.success i {
            color: #4ade80;
        }
        .toast.error i {
            color: #f87171;
        }
        .toast.info i {
            color: #60a5fa;
        }

        @media (max-width: 1024px) {
            .dashboard-layout {
                flex-direction: column;
            }
            .sidebar {
                width: 100%;
                position: static;
                max-height: none;
                display: flex;
                flex-wrap: wrap;
                gap: 0.3rem;
                padding: 0.8rem;
                border-radius: 1.4rem;
            }
            .sidebar .sidebar-title {
                display: none;
            }
            .sidebar .nav-item {
                padding: 0.5rem 0.8rem;
                font-size: 0.8rem;
                width: auto;
                border-radius: 60px;
            }
            .sidebar .nav-item .badge {
                display: none;
            }
            .form-grid {
                grid-template-columns: 1fr;
            }
        }
        @media (max-width: 768px) {
            .site-wrapper {
                padding: 1rem;
            }
            .top-nav {
                padding: 0.6rem 1.2rem;
                border-radius: 1.5rem;
            }
            .brand h1 {
                font-size: 1rem;
            }
            .hero-banner {
                padding: 1.2rem 1.2rem;
                border-radius: 1.5rem;
            }
            .hero-banner h2 {
                font-size: 1.2rem;
            }
            .stats-row {
                grid-template-columns: repeat(3, 1fr);
                gap: 0.5rem;
            }
            .stat-card {
                padding: 0.6rem 0.3rem;
            }
            .stat-card .stat-number {
                font-size: 1.2rem;
            }
            .section-card {
                padding: 1.2rem 1rem;
                border-radius: 1.4rem;
            }
            .data-table {
                font-size: 0.75rem;
            }
            .data-table th,
            .data-table td {
                padding: 0.4rem 0.5rem;
            }
            .user-section .greeting {
                font-size: 0.7rem;
            }
            .btn-logout span {
                display: none;
            }
            .btn-logout i {
                font-size: 1rem;
            }
            .btn-logout {
                padding: 0.4rem 0.8rem;
            }
            .toast {
                bottom: 1rem;
                right: 1rem;
                left: 1rem;
                border-radius: 1rem;
                justify-content: center;
                font-size: 0.8rem;
                padding: 0.7rem 1.2rem;
            }
        }
    </style>
</head>
<body>

    <div class="site-wrapper">

        <!-- ===== LOCAL ACCESS ONLY NOTICE ===== -->
        <div class="local-notice">
            <i class="fas fa-laptop"></i>
            <p><strong>🔒 Admin Panel</strong> — This page is designed to run locally on your laptop. It will not work if accessed from the internet.</p>
        </div>

        <!-- ===== TOP NAV ===== -->
        <nav class="top-nav">
            <a href="#" class="brand">
                <div class="brand-icon"><i class="fas fa-user-shield"></i></div>
                <div><h1>Knowledge <span>Nexus</span></h1></div>
            </a>
            <div class="user-section">
                <span class="greeting"><i class="fas fa-user-tie" style="color:#f59e0b;"></i> <span id="adminName">Admin</span></span>
                <div class="avatar" id="adminAvatar">AD</div>
                <button class="btn-logout" id="logoutBtn"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></button>
            </div>
        </nav>

        <!-- ===== HERO BANNER ===== -->
        <div class="hero-banner">
            <h2><i class="fas fa-user-shield"></i> Admin Dashboard</h2>
            <p>Complete control over your coaching institute — manage teachers, students, and all content.</p>
            <div class="admin-badge"><i class="fas fa-crown"></i> Administrator</div>
        </div>

        <!-- ===== STATS ROW ===== -->
        <div class="stats-row" id="statsRow">
            <div class="stat-card"><span class="stat-icon blue"><i class="fas fa-user-graduate"></i></span><div class="stat-number" id="statStudents">0</div><div class="stat-label">Students</div></div>
            <div class="stat-card"><span class="stat-icon green"><i class="fas fa-user-tie"></i></span><div class="stat-number" id="statTeachers">0</div><div class="stat-label">Teachers</div></div>
            <div class="stat-card"><span class="stat-icon yellow"><i class="fas fa-rupee-sign"></i></span><div class="stat-number" id="statFees">0</div><div class="stat-label">Fee Records</div></div>
            <div class="stat-card"><span class="stat-icon purple"><i class="fas fa-pencil-alt"></i></span><div class="stat-number" id="statTests">0</div><div class="stat-label">Tests</div></div>
            <div class="stat-card"><span class="stat-icon orange"><i class="fas fa-book"></i></span><div class="stat-number" id="statHomework">0</div><div class="stat-label">Homework</div></div>
            <div class="stat-card"><span class="stat-icon red"><i class="fas fa-bullhorn"></i></span><div class="stat-number" id="statNotices">0</div><div class="stat-label">Notices</div></div>
        </div>

        <!-- ===== DASHBOARD LAYOUT ===== -->
        <div class="dashboard-layout">

            <!-- ===== SIDEBAR ===== -->
            <nav class="sidebar" id="sidebar">
                <div class="sidebar-title">MENU</div>
                <button class="nav-item active" data-section="dashboard"><i class="fas fa-th-large"></i> Dashboard</button>
                <button class="nav-item" data-section="teacher-management"><i class="fas fa-user-tie"></i> Teachers <span class="badge" id="teacherBadge">0</span></button>
                <button class="nav-item" data-section="student-management"><i class="fas fa-user-graduate"></i> Students <span class="badge" id="studentBadge">0</span></button>
                <button class="nav-item" data-section="fee-management"><i class="fas fa-rupee-sign"></i> Fees <span class="badge" id="feeBadge">0</span></button>
                <button class="nav-item" data-section="study-material"><i class="fas fa-book-open"></i> Study Material</button>
                <button class="nav-item" data-section="notification-management"><i class="fas fa-bullhorn"></i> Notices <span class="badge" id="noticeBadge">0</span></button>
                <button class="nav-item" data-section="homework-management"><i class="fas fa-book"></i> Homework <span class="badge" id="hwBadge">0</span></button>
                <button class="nav-item" data-section="test-management"><i class="fas fa-pencil-alt"></i> Tests <span class="badge" id="testBadge">0</span></button>
                <button class="nav-item" data-section="subjects"><i class="fas fa-th-list"></i> Subjects</button>
                <button class="nav-item" data-section="chapters"><i class="fas fa-layer-group"></i> Chapters</button>
            </nav>

            <!-- ===== CONTENT AREA ===== -->
            <div class="content-area">

                <!-- ===== DASHBOARD ===== -->
                <div class="section-card active" id="section-dashboard">
                    <div class="section-header">
                        <h3><i class="fas fa-th-large"></i> Dashboard</h3>
                        <span class="sub-text"><i class="far fa-calendar-alt"></i> <span id="dashDate"></span></span>
                    </div>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px,1fr)); gap:1rem; margin-bottom:1.5rem;">
                        <div style="background:#eef2ff; border-radius:1rem; padding:1.2rem; text-align:center;">
                            <div style="font-size:2rem; color:#2563eb;"><i class="fas fa-user-graduate"></i></div>
                            <div style="font-size:1.3rem; font-weight:800; color:#0b1e3a;" id="dashStudents">0</div>
                            <div style="font-size:0.8rem; color:#94a3b8;">Students</div>
                        </div>
                        <div style="background:#f0fdf4; border-radius:1rem; padding:1.2rem; text-align:center;">
                            <div style="font-size:2rem; color:#22c55e;"><i class="fas fa-user-tie"></i></div>
                            <div style="font-size:1.3rem; font-weight:800; color:#0b1e3a;" id="dashTeachers">0</div>
                            <div style="font-size:0.8rem; color:#94a3b8;">Teachers</div>
                        </div>
                        <div style="background:#fef3c7; border-radius:1rem; padding:1.2rem; text-align:center;">
                            <div style="font-size:2rem; color:#f59e0b;"><i class="fas fa-rupee-sign"></i></div>
                            <div style="font-size:1.3rem; font-weight:800; color:#0b1e3a;" id="dashFees">0</div>
                            <div style="font-size:0.8rem; color:#94a3b8;">Fee Records</div>
                        </div>
                        <div style="background:#fef2f2; border-radius:1rem; padding:1.2rem; text-align:center;">
                            <div style="font-size:2rem; color:#ef4444;"><i class="fas fa-bullhorn"></i></div>
                            <div style="font-size:1.3rem; font-weight:800; color:#0b1e3a;" id="dashNotices">0</div>
                            <div style="font-size:0.8rem; color:#94a3b8;">Notices</div>
                        </div>
                        <div style="background:#f5f3ff; border-radius:1rem; padding:1.2rem; text-align:center;">
                            <div style="font-size:2rem; color:#8b5cf6;"><i class="fas fa-pencil-alt"></i></div>
                            <div style="font-size:1.3rem; font-weight:800; color:#0b1e3a;" id="dashTests">0</div>
                            <div style="font-size:0.8rem; color:#94a3b8;">Tests</div>
                        </div>
                        <div style="background:#fff7ed; border-radius:1rem; padding:1.2rem; text-align:center;">
                            <div style="font-size:2rem; color:#f97316;"><i class="fas fa-book"></i></div>
                            <div style="font-size:1.3rem; font-weight:800; color:#0b1e3a;" id="dashHomework">0</div>
                            <div style="font-size:0.8rem; color:#94a3b8;">Homework</div>
