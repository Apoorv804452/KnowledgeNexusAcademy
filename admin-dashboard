                }).then(() => {
                    showToast('Test added!', 'success');
                    document.getElementById('adminTestName').value = '';
                    document.getElementById('adminTestMarks').value = '';
                    loadAllData();
                }).catch(err => showToast('Error: ' + err.message, 'error'));
            });

            // Add Subject
            document.getElementById('adminAddSubjectBtn').addEventListener('click', function() {
                const classVal = document.getElementById('adminSubjectClass').value;
                const name = document.getElementById('adminSubjectName').value.trim();
                const code = document.getElementById('adminSubjectCode').value.trim();
                const teacher = document.getElementById('adminSubjectTeacher').value.trim();

                if (!classVal || !name) {
                    showToast('Please select a class and enter a subject name.', 'error');
                    return;
                }

                db.collection('subjects').add({
                    class: classVal,
                    name,
                    code,
                    teacher,
                    createdAt: firebase.firestore.FieldValue.serverTimestamp()
                }).then(() => {
                    showToast('Subject added!', 'success');
                    document.getElementById('adminSubjectName').value = '';
                    document.getElementById('adminSubjectCode').value = '';
                    document.getElementById('adminSubjectTeacher').value = '';
                    loadAllData();
                }).catch(err => showToast('Error: ' + err.message, 'error'));
            });

            // Add Chapter
            document.getElementById('adminAddChapterBtn').addEventListener('click', function() {
                const classVal = document.getElementById('adminChapterClass').value;
                const subject = document.getElementById('adminChapterSubject').value;
                const number = document.getElementById('adminChapterNumber').value.trim();
                const name = document.getElementById('adminChapterName').value.trim();
                const desc = document.getElementById('adminChapterDesc').value.trim();

                if (!classVal || !subject || !name) {
                    showToast('Please fill in Class, Subject, and Chapter Name.', 'error');
                    return;
                }

                db.collection('chapters').add({
                    class: classVal,
                    subject,
                    number,
                    name,
                    description: desc,
                    createdAt: firebase.firestore.FieldValue.serverTimestamp()
                }).then(() => {
                    showToast('Chapter added!', 'success');
                    document.getElementById('adminChapterName').value = '';
                    document.getElementById('adminChapterNumber').value = '';
                    document.getElementById('adminChapterDesc').value = '';
                    loadAllData();
                }).catch(err => showToast('Error: ' + err.message, 'error'));
            });

            // ===== NOTICE TARGET DYNAMIC =====
            document.getElementById('adminNoticeTarget').addEventListener('change', function() {
                const target = this.value;
                const targetSelect = document.getElementById('adminNoticeTargetValue');
                targetSelect.innerHTML = '';
                if (target === 'all') {
                    targetSelect.innerHTML = '<option value="all">All Students</option>';
                } else if (target === 'class') {
                    const classes = [...new Set(allStudents.map(s => s.class).filter(Boolean))].sort();
                    classes.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c;
                        opt.textContent = 'Class ' + c;
                        targetSelect.appendChild(opt);
                    });
                } else if (target === 'individual') {
                    allStudents.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.uid;
                        opt.textContent = s.name + ' (' + (s.class ? 'Class ' + s.class : 'N/A') + ')';
                        targetSelect.appendChild(opt);
                    });
                }
            });

            // ===== ESCAPE TOAST =====
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    const toast = document.getElementById('toast');
                    toast.classList.remove('show');
                    clearTimeout(toastTimeout);
                }
            });

            console.log('👑 Admin Dashboard loaded');
            console.log('📌 Only accessible via localhost');

        })();
    </script>
</body>
</html>
