    <div class="toast" id="toast"><i class="fas fa-circle-info"></i><span id="toastMessage">Message</span></div>

    <script>
        (function() {
            'use strict';

            // ===== YOUR FIREBASE CONFIG =====
            const firebaseConfig = {
                apiKey: "YOUR_API_KEY",
                authDomain: "YOUR_PROJECT.firebaseapp.com",
                projectId: "YOUR_PROJECT_ID",
                storageBucket: "YOUR_PROJECT.appspot.com",
                messagingSenderId: "YOUR_SENDER_ID",
                appId: "YOUR_APP_ID"
            };

            firebase.initializeApp(firebaseConfig);
            const auth = firebase.auth();
            const db = firebase.firestore();

            // ===== DOM REFS =====
            const adminName = document.getElementById('adminName');
            const adminAvatar = document.getElementById('adminAvatar');
            const logoutBtn = document.getElementById('logoutBtn');

            // Stats
            const statStudents = document.getElementById('statStudents');
            const statTeachers = document.getElementById('statTeachers');
            const statFees = document.getElementById('statFees');
            const statTests = document.getElementById('statTests');
            const statHomework = document.getElementById('statHomework');
            const statNotices = document.getElementById('statNotices');

            // Badges
            const studentBadge = document.getElementById('studentBadge');
            const teacherBadge = document.getElementById('teacherBadge');
            const feeBadge = document.getElementById('feeBadge');
            const hwBadge = document.getElementById('hwBadge');
            const testBadge = document.getElementById('testBadge');
            const noticeBadge = document.getElementById('noticeBadge');

            let allStudents = [];
            let allTeachers = [];
            let allFees = [];
            let allHomework = [];
            let allTests = [];
            let allNotices = [];
            let allMaterials = [];
            let allSubjects = [];
            let allChapters = [];

            let currentUserId = null;

            // ===== TOAST =====
            let toastTimeout = null;

            function showToast(message, type = 'info') {
                const toast = document.getElementById('toast');
                const toastMsg = document.getElementById('toastMessage');
                const icon = toast.querySelector('i');
                toast.className = 'toast ' + type;
                toastMsg.textContent = message;
                if (type === 'success') icon.className = 'fas fa-check-circle';
                else if (type === 'error') icon.className = 'fas fa-exclamation-circle';
                else icon.className = 'fas fa-circle-info';
                clearTimeout(toastTimeout);
                toast.classList.add('show');
                toastTimeout = setTimeout(() => toast.classList.remove('show'), 4000);
            }

            // ===== NAVIGATION =====
            const navItems = document.querySelectorAll('.nav-item');
            const sections = document.querySelectorAll('.section-card');

            navItems.forEach(item => {
                item.addEventListener('click', function() {
                    navItems.forEach(i => i.classList.remove('active'));
                    this.classList.add('active');
                    sections.forEach(s => s.classList.remove('active'));
                    document.getElementById('section-' + this.dataset.section).classList.add('active');
                });
            });

            // ===== AUTH =====
            auth.onAuthStateChanged(user => {
                if (user) {
                    currentUserId = user.uid;
                    // Check if admin
                    db.collection('users').doc(user.uid).get()
                        .then(doc => {
                            if (doc.exists && doc.data().role === 'admin') {
                                // Load admin profile
                                const name = doc.data().name || 'Admin';
                                adminName.textContent = name;
                                const initials = name.split(' ').map(n => n[0]).join('').substring(0, 2)
                                    .toUpperCase();
                                adminAvatar.textContent = initials;
                                loadAllData();
                            } else {
                                // Not admin - redirect to login
                                showToast('Access denied. Admin only.', 'error');
                                setTimeout(() => window.location.href = 'index.html', 1500);
                            }
                        })
                        .catch(() => {
                            showToast('Access denied. Admin only.', 'error');
                            setTimeout(() => window.location.href = 'index.html', 1500);
                        });
                } else {
                    window.location.href = 'index.html';
                }
            });

            logoutBtn.addEventListener('click', () => {
                auth.signOut().then(() => {
                    showToast('Logged out.', 'info');
                    setTimeout(() => window.location.href = 'index.html', 500);
                }).catch(err => showToast('Error: ' + err.message, 'error'));
            });

            // ===== LOAD ALL DATA =====
            function loadAllData() {
                if (!currentUserId) return;

                // Students
                db.collection('students').get()
                    .then(snapshot => {
                        allStudents = [];
                        snapshot.forEach(doc => {
                            allStudents.push({ uid: doc.id, ...doc.data() });
                        });
                        renderAdminStudentList();
                        updateAdminDropdowns();
                        updateStats();
                        updateBadges();
                    })
                    .catch(err => console.error('Error loading students:', err));

                // Teachers
                db.collection('teachers').get()
                    .then(snapshot => {
                        allTeachers = [];
                        snapshot.forEach(doc => {
                            allTeachers.push({ uid: doc.id, ...doc.data() });
                        });
                        renderAdminTeacherList();
                        updateStats();
                        updateBadges();
                    })
                    .catch(err => console.error('Error loading teachers:', err));

                // Fees
                db.collection('fees').get()
                    .then(snapshot => {
                        allFees = [];
                        snapshot.forEach(doc => {
                            allFees.push({ id: doc.id, ...doc.data() });
                        });
                        renderAdminFeeList();
                        updateStats();
                        updateBadges();
                    })
                    .catch(err => console.error('Error loading fees:', err));

                // Homework
                db.collection('homework').get()
                    .then(snapshot => {
                        allHomework = [];
                        snapshot.forEach(doc => {
                            allHomework.push({ id: doc.id, ...doc.data() });
                        });
                        renderAdminHomeworkList();
                        updateStats();
                        updateBadges();
                    })
                    .catch(err => console.error('Error loading homework:', err));

                // Tests
                db.collection('tests').get()
                    .then(snapshot => {
                        allTests = [];
                        snapshot.forEach(doc => {
                            allTests.push({ id: doc.id, ...doc.data() });
                        });
                        renderAdminTestList();
                        updateStats();
                        updateBadges();
                    })
                    .catch(err => console.error('Error loading tests:', err));

                // Notices
                db.collection('notices').get()
                    .then(snapshot => {
                        allNotices = [];
                        snapshot.forEach(doc => {
                            allNotices.push({ id: doc.id, ...doc.data() });
                        });
                        renderAdminNoticeList();
                        updateStats();
                        updateBadges();
                    })
                    .catch(err => console.error('Error loading notices:', err));

                // Materials
                db.collection('materials').get()
                    .then(snapshot => {
                        allMaterials = [];
                        snapshot.forEach(doc => {
                            allMaterials.push({ id: doc.id, ...doc.data() });
                        });
                        renderAdminMaterialList();
                    })
                    .catch(err => console.error('Error loading materials:', err));

                // Subjects
                db.collection('subjects').get()
                    .then(snapshot => {
                        allSubjects = [];
                        snapshot.forEach(doc => {
                            allSubjects.push({ id: doc.id, ...doc.data() });
                        });
                        renderAdminSubjectList();
                    })
                    .catch(err => console.error('Error loading subjects:', err));

                // Chapters
                db.collection('chapters').get()
                    .then(snapshot => {
                        allChapters = [];
                        snapshot.forEach(doc => {
                            allChapters.push({ id: doc.id, ...doc.data() });
                        });
                        renderAdminChapterList();
                    })
                    .catch(err => console.error('Error loading chapters:', err));
            }

            // ===== UPDATE DROPDOWNS =====
            function updateAdminDropdowns() {
                const selects = ['adminFeeStudent', 'adminHomeworkStudent', 'adminTestStudent', 'adminNoticeTargetValue'];
                selects.forEach(id => {
                    const select = document.getElementById(id);
                    if (!select) return;
                    const currentVal = select.value;
                    select.innerHTML = '<option value="">Select Student</option>';
                    allStudents.forEach(s => {
